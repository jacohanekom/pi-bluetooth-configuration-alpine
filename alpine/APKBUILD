# Maintainer: Jaco Hanekom <jhanekom@gmail.com>
pkgname=pi-bluetooth-configuration
pkgver=1.0.0
pkgrel=0
pkgdesc="Configure WiFi over a fallback access point (Alpine/OpenRC, Raspberry Pi 3/Zero)"
url="https://github.com/jacohanekom/pi-bluetooth-configuration-alpine"
# aarch64: Pi 3 and other 64-bit-capable boards. armhf: Pi Zero/Zero W
# (original) -- ARMv6, 32-bit, no aarch64 support at all. Both verified
# to actually build via Docker's --platform linux/arm/v6 (armhf has no
# native GitHub Actions runner, so CI builds it under QEMU emulation --
# see build.yml's build-armhf/apk-armhf jobs).
arch="aarch64 armhf"
license="custom"
makedepends="openssl-dev pkgconf"
depends="libcrypto3 wpa_supplicant wpa_supplicant-openrc dhcpcd dhcpcd-openrc iproute2 dnsmasq dnsmasq-openrc iptables hostapd hostapd-openrc"
options="!check"

source=""
builddir="$srcdir"

# main.cpp and its headers, config.ini, and the OpenRC init script live
# one directory up (this repo's root), not in a source= tarball, since
# they're part of this same repo rather than a separate upstream project.
# openssl (libcrypto) is a normal Alpine package -- nothing to vendor or
# build from source here. No dbus/bluez/BLE here at all: setup is done
# entirely over the Pi's own onboard WiFi radio -- station mode to join
# a real network, hostapd-driven AP mode as the fallback when that
# fails or nothing's configured yet (see ap_control.hpp) -- with a
# plain HTTP API (http_server.hpp) for a phone to talk to either way,
# discoverable via a hand-rolled mDNS responder (mdns_responder.hpp)
# rather than Avahi -- Avahi hard-depends on the `dbus` package in
# Alpine, which would reintroduce exactly the daemon/service-management
# surface removed above.
prepare() {
	default_prepare
	cp "$startdir"/../src/main.cpp "$srcdir"/main.cpp
	cp "$startdir"/../src/config.hpp "$srcdir"/config.hpp
	cp "$startdir"/../src/ap_control.hpp "$srcdir"/ap_control.hpp
	cp "$startdir"/../src/eth_control.hpp "$srcdir"/eth_control.hpp
	cp "$startdir"/../src/http_server.hpp "$srcdir"/http_server.hpp
	cp "$startdir"/../src/mdns_responder.hpp "$srcdir"/mdns_responder.hpp
	cp "$startdir"/../src/relay_control.hpp "$srcdir"/relay_control.hpp
	cp "$startdir"/../src/victron_control.hpp "$srcdir"/victron_control.hpp
	cp "$startdir"/../src/wifi_control.hpp "$srcdir"/wifi_control.hpp
	cp "$startdir"/../src/subprocess.hpp "$srcdir"/subprocess.hpp
	cp "$startdir"/../config.ini "$srcdir"/config.ini
	cp "$startdir"/../wpa_supplicant.conf "$srcdir"/wpa_supplicant.conf
	cp "$startdir"/../openrc/pi-bluetooth-configuration.initd "$srcdir"/pi-bluetooth-configuration.initd
}

build() {
	g++ -Wall -Wextra -O2 -std=c++20 -pthread \
		$(pkg-config --cflags libcrypto) \
		-o pi-bluetooth-configuration main.cpp \
		$(pkg-config --libs libcrypto) -pthread
}

package() {
	install -Dm755 pi-bluetooth-configuration "$pkgdir"/usr/bin/pi-bluetooth-configuration
	install -Dm644 config.ini "$pkgdir"/etc/pi-bluetooth-configuration/config.ini
	install -Dm755 pi-bluetooth-configuration.initd "$pkgdir"/etc/init.d/pi-bluetooth-configuration
	# apk's own upgrade logic already preserves this if it's been
	# modified on disk since install (e.g. real network{} blocks saved
	# by WifiControl::connect()/stage()) -- no need to guard that here.
	# See wpa_supplicant.conf's own header comment for why this needs to
	# ship at all.
	install -Dm600 wpa_supplicant.conf "$pkgdir"/etc/wpa_supplicant/wpa_supplicant.conf
}
