#!/sbin/openrc-run

name="pi-bluetooth-configuration"
description="Configure WiFi from a browser over Ethernet"

command="/usr/bin/pi-bluetooth-configuration"
command_args="--config /etc/pi-bluetooth-configuration/config.ini"
command_user="root"

supervisor=supervise-daemon
respawn_delay=5
respawn_max=0

pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

depend() {
    # No dbus/bluetooth need here -- setup happens entirely over a
    # browser-based web UI served over Ethernet (see src/web_ui.hpp/
    # main.cpp's own header comment), not BLE, and no longer via a
    # phone-joined fallback access point either -- hostapd isn't used by
    # this daemon at all anymore, so there's no AP-mode service lifecycle
    # to coordinate with here.
    #
    # Deliberately "after", NOT "need": eth0/eth1's gateway IP and the
    # web UI itself (both driven by this same daemon -- see main.cpp)
    # have to keep working even if wpa_supplicant fails to start at all,
    # since the web UI over Ethernet is now the *only* way to fix a
    # broken WiFi configuration -- a `need` dependency would refuse to
    # start this whole daemon (and with it, the only recovery path) just
    # because wpa_supplicant itself is broken. The 20s station-connect
    # timeout in main.cpp's own boot sequence already tolerates
    # wpa_supplicant not being up yet regardless.
    after wpa_supplicant
    after firewall
}
