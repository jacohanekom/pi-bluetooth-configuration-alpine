#!/sbin/openrc-run

name="pi-bluetooth-configuration"
description="Configure WiFi over Bluetooth LE"

command="/usr/bin/pi-bluetooth-configuration"
command_args="--config /etc/pi-bluetooth-configuration/config.ini"
command_user="root"

supervisor=supervise-daemon
respawn_delay=5
respawn_max=0

pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

depend() {
    # No dbus/bluetooth need here -- the BLE peripheral role lives on a
    # Pico's own BTstack build now (see src/pico_transport.hpp),
    # connected over USB as a plain serial port. OpenRC has no clean
    # "wait for this USB device node to exist" dependency; if the Pico
    # isn't plugged in (or hasn't finished enumerating) yet when this
    # starts, pico_transport.hpp's start() just fails to open the serial
    # port and this daemon exits non-zero, which supervise-daemon's
    # respawn_delay/respawn_max above already retry indefinitely.
    need wpa_supplicant
    after firewall
}
