#!/sbin/openrc-run
# Identical to sdcard-image-pi3's own copy of this file -- genuinely
# architecture-independent (plain OpenRC/shell, no aarch64-vs-armhf
# distinction anywhere in it), so it's duplicated here rather than
# shared from one place, matching this build's own self-contained-
# per-image-directory convention (see sdcard-image-pi3.yml/
# sdcard-image-pi-zero.yml, each `cd`-ing into its own directory).
# Browser-based terminal -- serves an xterm.js UI over plain HTTP on
# :3000 (LAN-reachable, same trust level sshd already has there; see
# build-image.sh's own Security note) that wraps a genuine `ssh -t
# localhost` subprocess in a websocket+pty. Unlike an earlier Wetty-
# based version of this, ttyd has no smart "running as root against
# localhost" special case to route around -- it just runs exactly the
# command line below, always, so there's nothing implicit to get wrong
# here the way --force-ssh mattered for Wetty. -W/--writable is
# load-bearing, not cosmetic: ttyd serves a read-only terminal by
# default, which would make this useless for anything beyond watching
# output.
name="ttyd"
description="Browser-based terminal (proxies to sshd via a real ssh subprocess)"

# The admin account pi-bluetooth-configuration creates the first time
# setup finishes (see src/main.cpp's create_admin_account(), and
# build-image.sh's own comment on why root SSH is now disabled
# image-wide) -- read fresh on every start/restart, not baked in at
# build time, since it doesn't exist until then. Before that first
# successful finish, this file doesn't exist yet, so the ssh target is
# just "localhost" with no explicit user -- ssh itself then prompts for
# a username interactively in the terminal, same as running it by hand,
# which is safe either way now that root itself is refused at sshd
# regardless of what gets typed there.
ADMIN_USER_FILE="/etc/admin-user"
SSH_TARGET="localhost"
if [ -f "$ADMIN_USER_FILE" ]; then
	SSH_TARGET="$(cat "$ADMIN_USER_FILE")@localhost"
fi

command="/usr/bin/ttyd"
# UserKnownHostsFile=/dev/null + StrictHostKeyChecking=no: host keys are
# regenerated fresh every boot (see "Config persistence across
# reboots"), so a real known_hosts file would just mean the first
# connection after every single boot hangs waiting for an interactive
# yes/no nobody's there to answer -- this is a loopback connection, not
# a real network hop, so there's nothing meaningful to pin here anyway.
command_args="-p 3000 -i 0.0.0.0 -W ssh -t \
	-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null $SSH_TARGET"
command_user="root"

supervisor=supervise-daemon
respawn_delay=5
respawn_max=0

pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

depend() {
	need net
	after sshd
}
